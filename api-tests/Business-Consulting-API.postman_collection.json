            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/consultants?specialization=Финансы",
              "host": ["{{base_url}}"],
              "path": ["consultants"],
              "query": [
                {
                  "key": "specialization",
                  "value": "Финансы"
                }
              ]
            }
          }
        },
        {
