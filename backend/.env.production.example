# ==============================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================
# IMPORTANT: Replace all placeholder values before deployment!

# Database Configuration
DATABASE_URL="postgresql://prod_user:CHANGE_THIS_PASSWORD@postgres:5432/business_consulting_prod?schema=public"

# JWT Configuration - CRITICAL: Generate a strong secret!
# Generate with: openssl rand -base64 32
JWT_SECRET="CHANGE_THIS_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARACTERS"
JWT_EXPIRATION="7d"

# Stripe Configuration
STRIPE_SECRET_KEY="sk_live_YOUR_LIVE_STRIPE_SECRET_KEY"
STRIPE_PUBLISHABLE_KEY="pk_live_YOUR_LIVE_STRIPE_PUBLISHABLE_KEY"
STRIPE_WEBHOOK_SECRET="whsec_YOUR_STRIPE_WEBHOOK_SECRET"

# Application Configuration
PORT=3000
NODE_ENV=production

# CORS Configuration
# Add your production frontend URLs (comma-separated)
CORS_ORIGIN="https://yourdomain.com,https://www.yourdomain.com,https://app.yourdomain.com"

# File Upload Configuration
MAX_FILE_SIZE=10485760 # 10MB in bytes
UPLOAD_PATH="/app/uploads"

# Database Connection Pool (for production optimization)
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Logging
LOG_LEVEL=info

# Redis (optional, for session storage/caching)
# REDIS_URL="redis://redis:6379"

# Email Service (optional, for notifications)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your-email@gmail.com"
# SMTP_PASSWORD="your-app-password"
# SMTP_FROM="noreply@yourdomain.com"

# Security
# Rate limiting
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100

# Monitoring (optional)
# SENTRY_DSN="https://your-sentry-dsn"
