# Токен бота от @BotFather (обязательно)
BOT_TOKEN=123456:ABC-DEF...

# ID личного чата Оксаны (менеджера), куда приходят брони и чеки (обязательно).
# Узнать: Оксана пишет боту @userinfobot, он присылает её ID.
OWNER_CHAT_ID=

# API-токен RealtyCalendar (необязательно, появится позже — запросить у их поддержки).
# Пока пусто — брони уходят только менеджеру в Telegram.
RC_API_TOKEN=

# ID тех, кто может загружать фото домиков (через запятую). Менеджер (OWNER_CHAT_ID)
# может всегда. Укажите сюда свой ID, если фото добавляете вы.
ADMIN_IDS=
