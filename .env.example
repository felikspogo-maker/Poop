# Токен бота от @BotFather (обязательно)
BOT_TOKEN=123456:ABC-DEF...

# ID личного чата организатора, куда бот пересылает заявки (обязательно).
# Узнать свой ID можно у бота @userinfobot.
ADMIN_CHAT_ID=

# --- Google Sheets (накопительная таблица участниц) ---
# Путь к файлу с ключом сервисного аккаунта Google (по умолчанию credentials.json)
GOOGLE_CREDENTIALS_FILE=credentials.json
# ID таблицы из ссылки: .../spreadsheets/d/<ЭТОТ_ID>/edit
GOOGLE_SHEET_ID=
# Название листа внутри таблицы (по умолчанию «Участницы»)
WORKSHEET_NAME=Участницы
