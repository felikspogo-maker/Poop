# Токен бота от @BotFather (обязательно)
BOT_TOKEN=123456:ABC-DEF...

# ID чата/группы администратора для пересылки заявок (узнать через @userinfobot)
ADMIN_CHAT_ID=

# Почта организаторов (по умолчанию 6408844@gmail.com)
TARGET_EMAIL=6408844@gmail.com

# SMTP для отправки заявок на почту (необязательно).
# Для Gmail используйте пароль приложения: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Папка для сохранённых заявок
SUBMISSIONS_DIR=submissions
